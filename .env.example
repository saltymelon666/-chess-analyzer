DEEPSEEK_API_KEY=replace-with-a-new-server-side-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
APP_ENV=development

STOCKFISH_PATH=stockfish.exe
STOCKFISH_DEPTH=16
STOCKFISH_THREADS=1
STOCKFISH_HASH=64
STOCKFISH_MULTIPV=3
STOCKFISH_TIMEOUT_SECONDS=30
GAME_ANALYSIS_DEPTH=10
GAME_ANALYSIS_TIMEOUT_SECONDS=240
GAME_ANALYSIS_MAX_PLIES=160
DEEPSEEK_TIMEOUT_SECONDS=30

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8501,http://127.0.0.1:8501,https://saltymelon666.github.io

# 真实支付只从部署环境读取。PAYMENT_PUBLIC_ORIGIN 必须是可公开访问的
# HTTPS 后端地址，用于接收微信和支付宝异步通知。
PAYMENT_PUBLIC_ORIGIN=https://api.example.com
PAYMENT_FRONTEND_ORIGIN=https://www.example.com
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_GATEWAY=https://api.mch.weixin.qq.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 人工审核收款码。图片应是本站 HTTPS 地址或 /assets 下的站内路径。
MANUAL_WECHAT_QR_URL=/assets/payment/wechat-personal-qr.webp
MANUAL_ALIPAY_QR_URL=/assets/payment/alipay-personal-qr.webp
